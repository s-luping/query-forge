# ── 安全配置（安全加固后必填项） ─────────────────────────
# JWT 签名密钥（优先级：环境变量 > 系统设置表；均缺失时应用拒绝启动）
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
QUERYFORGE_SECRET_KEY=
# Fernet 加密密钥（用于 api_key/数据源密码加密，与 JWT 密钥分离；缺省时从 SECRET_KEY 派生）
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QUERYFORGE_FERNET_KEY=
# 启用 HTTPS 后置 1（cookie 加 Secure 标志）
QUERYFORGE_COOKIE_SECURE=
# CORS 白名单（逗号分隔；前端与 API 同源部署时留空）
QUERYFORGE_CORS_ORIGINS=
# iframe 嵌入白名单（逗号分隔，对应 CSP frame-ancestors；默认仅允许同源嵌入）
# 例：QUERYFORGE_FRAME_ANCESTORS=http://127.0.0.1:3000,http://portal.example.com
# 如需允许任意站点嵌入（不推荐），可设为 *
QUERYFORGE_FRAME_ANCESTORS=

# ── 运行配置 ─────────────────────────────────────────────
QUERYFORGE_HOST=0.0.0.0
QUERYFORGE_PORT=8188
QUERYFORGE_DEBUG=

# ── 数据库路径配置（可覆盖默认路径） ─────────────────────
QUERYFORGE_MAIN_DB=db/queryforge.db
QUERYFORGE_TELEMETRY_DB=db/llm_telemetry.db

# ── 脚本用外部数据库连接（scripts/batch_generate.py 等） ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=your_database
DB_TABLES=table1,table2
OUTPUT_DIR=.
