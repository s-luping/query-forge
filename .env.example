# ============================================================
# QueryForge 环境配置
# 用法：cp .env.example .env，然后取消注释下方对应的一行即可
# ============================================================

# ── 数据库 ──────────────────────────────────────────────
# 留空或不设置 = 默认 SQLite（本地文件，无需安装数据库）
# 取消注释下面一行 = 切换到 MySQL
# DATABASE_URL=mysql+pymysql://用户名:密码@主机:3306/queryforge?charset=utf8mb4

# 取消注释下面一行 = 切换到 PostgreSQL
# DATABASE_URL=postgresql+psycopg2://用户名:密码@主机:5432/queryforge

# 遥测库（LLM 调用日志）单独指定，留空时：
#   - SQLite 模式：使用独立的 llm_telemetry.db 文件
#   - MySQL/PG 模式：与主库同址（表通过 ORM Base 隔离）
# TELEMETRY_DATABASE_URL=mysql+pymysql://用户名:密码@主机:3306/queryforge_telemetry?charset=utf8mb4

# ── 数据库连接池（可选，默认值已调优） ──────────────────
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=3600
# DB_ECHO=False

# ── 运行配置（可选） ────────────────────────────────────
# HOST=0.0.0.0
# PORT=8888
# DEBUG=False

# ── 安全配置（可选） ────────────────────────────────────
# SECRET_KEY=                  # 留空则首次启动自动生成
# FERNET_KEY=                  # 留空时从 SECRET_KEY 派生
# COOKIE_SECURE=False          # 启用 HTTPS 后改为 True
