# ========================================
# QueryForge 环境变量配置示例
# 复制为 .env 并填写实际值
# 命令: cp .env.example .env
# ========================================

# ---------------- 服务配置 ----------------
HOST=0.0.0.0
PORT=8888
DEBUG=false

# ---------------- 数据库配置 ----------------
# 主数据库（三选一，或同时配置多个）
# SQLite（开发/轻量部署默认）
DATABASE_URL=sqlite:///./queryforge.db
# MySQL: mysql+pymysql://user:pass@host:3306/queryforge?charset=utf8mb4
# PostgreSQL: postgresql+psycopg2://user:pass@host:5432/queryforge

# 遥测数据库（LLM 调用日志记录，可选）
TELEMETRY_DATABASE_URL=

# 操作日志数据库（可选，默认与主库相同）
LOGS_DATABASE_URL=

# ---------------- 安全密钥 ----------------
# ⚠️ 生产环境必须设置！使用以下命令生成：
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FERNET_KEY=

# ---------------- JWT 配置 ----------------
# Token 过期时间（分钟），默认 4320（3天）
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# ---------------- 功能开关 ----------------
# 是否允许用户注册
ALLOW_REGISTER=true

# ---------------- CORS 配置 ----------------
# 允许的跨域来源（逗号分隔，生产环境请改为实际域名）
# 示例: CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=

# ---------------- Embedding 模型配置 ----------------
# BGE-M3 模型是否已下载就绪
EMBEDDING_MODEL_READY=false
# 模型本地路径（如已下载）
EMBEDDING_MODEL